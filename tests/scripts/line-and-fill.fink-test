# Line art on the Line layer, fill on the Fill layer, and the tools refuse the wrong layer.
new 32 32
hover canvas
layer Line
tool Pencil
color 1

# a box with a 1px gap in the top edge
stroke 4,4 9,4
stroke 11,4 20,4
stroke 20,4 20,20 4,20 4,4
assert pixel Line 4,4 == 1
assert pixel Line 10,4 == 0
assert history == 3

# fill refuses the Line layer and says why
tool Fill
color 8
stroke 12,12
assert pixel Fill 12,12 == 0
assert status ~= Fill layer

# on the Fill layer, gap closing keeps it inside the box
layer Fill
set gap 1
stroke 12,12
assert pixel Fill 12,12 == 8
assert pixel Fill 5,5 == 8
assert pixel Fill 1,1 == 0
assert history == 4

# pencil refuses the Fill layer
tool Pencil
color 1
stroke 1,1
assert pixel Fill 1,1 == 0

# with auto-select on, the pencil jumps to the Line layer instead
set autolayer on
stroke 1,1
assert layer == Line
assert pixel Line 1,1 == 1
