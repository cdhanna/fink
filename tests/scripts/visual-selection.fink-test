# Selection and transform, for checking by eye. Headless, the shots are skipped.
new 64 64
wait 6
set zoom 10
hover canvas
tool Pencil
layer Line
color 1
stroke 20,14 30,10 40,12 48,20 50,32 46,44 36,50 24,48 16,40 14,28 18,18 20,14
stroke 28,26 28,30
stroke 38,26 38,30
layer Fill
tool Fill
color 9
stroke 32,20

# lasso round the whole creature, line art and fill together
cmd selection.allLayers
tool Lasso
stroke 11,7 55,7 55,55 11,55
assert floating == False
shot 10-lasso-selection

# the transform tool lifts it and shows handles
tool Transform
stroke 33,30
assert floating == True
shot 11-transform-handles

# drag just outside the top-left corner to rotate about 30 degrees
stroke 10.0,6.0 26.3,-1.0
assert transform ~= ,1,1,
shot 12-rotated

key Enter
assert floating == False
shot 13-applied
shot 14-applied-canvas canvas
