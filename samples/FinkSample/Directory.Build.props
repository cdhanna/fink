<Project>
    <!-- The Fink sample game. Fade.MonoGame comes BY SOURCE from ../fade.mono (beside the fink
         repo), so these pins must stay in step with fade.mono's Directory.Build.props.
         This file also stops the fink repo's own Directory.Build.props from applying here. -->
    <PropertyGroup>
        <!-- Must match fade.mono's FadeVersion or the build fails with CS1704. -->
        <FadeVersion Condition="'$(FadeVersion)' == ''">0.3.1.1</FadeVersion>
        <MonogameVersion>3.8.6</MonogameVersion>
        <ImGuiVersion>1.91.6.1</ImGuiVersion>

        <FadeMonoDir Condition="'$(FadeMonoDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\fade.mono</FadeMonoDir>
    </PropertyGroup>

    <!-- OpenGL (MonoGame DesktopGL), like Fink itself, so a shader previewed in Fink is compiled
         the same way here. -p:FadeMonoGamePlatform=DesktopVK builds it for Vulkan instead. -->
    <PropertyGroup Condition="'$(FadeMonoGamePlatform)' == ''">
        <FadeMonoGamePlatform>Desktop</FadeMonoGamePlatform>
    </PropertyGroup>

    <!-- Per-backend intermediates, as in fade.mono and Soundrel. -->
    <PropertyGroup>
        <BaseIntermediateOutputPath>obj\$(FadeMonoGamePlatform)\</BaseIntermediateOutputPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;art/**</DefaultItemExcludes>
    </PropertyGroup>
</Project>
