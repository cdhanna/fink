` THE FINK SAMPLE. Plays the animations drawn in art/sample.fink. Fink exported them into
` Assets/Textures (the atlas) and fink_sprites.fbasic (TAG_ and PAL_ constants for every clip and
` palette row, listed before this file in FinkSample.csproj).
`
`   left / right   walk the slime          space   hop (a clip that plays once)
`   P              swap its palette        S       faster / slower
`   M              show the "light" data map (emissive in red, the normal in green and blue)
`
` The slime's position is its pivot, set in Fink (its feet), and the little coin rides on its
` POINT_SLIME_TOP, a point placed on each of its drawings.
`
` Open art/sample.fink in Fink, change a drawing, and export (Ctrl+E): a Debug build shows it here
` at once.

#constant SPR_SLIME 1
#constant SPR_COINS 10
#constant COIN_COUNT 6
#constant SPR_PARADE 20
#constant SPR_HAT 30
#constant SPR_MAP 40
#constant GROUND 210

set render size 480, 270
set background color rgb(36, 34, 48)

atlas = fink_load_sprites()

` the player's slime: feet on the ground, idling
sprite SPR_SLIME, 240, GROUND, 0
scale sprite SPR_SLIME, 2, 2
play fink sprite SPR_SLIME, TAG_SLIME_IDLE

` a coin on its head, kept on the point every frame
sprite SPR_HAT, 0, 0, 0
play fink sprite SPR_HAT, TAG_COIN_SPIN

` the data map, as it is: hidden until M
sprite SPR_MAP, 440, 40, fink atlas map(atlas, MAP_LIGHT)
scale sprite SPR_MAP, 2, 2
hide sprite SPR_MAP
mapShown = 0
keyM = scanCode("M")

` a row of coins, each a few frames into the spin, so they don't turn together
FOR i = 0 TO COIN_COUNT - 1
    sprite SPR_COINS + i, 90 + i * 60, 60, 0
    scale sprite SPR_COINS + i, 2, 2
    play fink sprite SPR_COINS + i, TAG_COIN_SPIN
    set fink sprite frame SPR_COINS + i, i
NEXT

` the slime's whole timeline (idle, then the hop), once in each palette
FOR i = 0 TO fink palette rows(atlas) - 1
    sprite SPR_PARADE + i, 40 + i * 50, 140, 0
    play fink sprite SPR_PARADE + i, TAG_SLIME
    set fink sprite palette SPR_PARADE + i, i
NEXT

global px# = 240.0
palette = PAL_BASE
speed# = 1.0
keyP = scanCode("P")
keyS = scanCode("S")

DO
    IF leftKey() THEN px# = px# - 1.5
    IF rightKey() THEN px# = px# + 1.5
    IF px# < 20 THEN px# = 20
    IF px# > 460 THEN px# = 460

    ` hop: a clip that plays once; back to idling when it's done
    IF new spaceKey()
        play fink sprite SPR_SLIME, TAG_SLIME_HOP
    ENDIF
    IF fink sprite clip(SPR_SLIME) = TAG_SLIME_HOP
        IF fink sprite done(SPR_SLIME) = 1
            play fink sprite SPR_SLIME, TAG_SLIME_IDLE
        ENDIF
    ENDIF

    IF new key down(keyP)
        palette = palette + 1
        IF palette >= fink palette rows(atlas) THEN palette = PAL_BASE
        set fink sprite palette SPR_SLIME, palette
    ENDIF
    IF new key down(keyS)
        speed# = speed# * 2.0
        IF speed# > 4.0 THEN speed# = 0.5
        set fink sprite speed SPR_SLIME, speed#
    ENDIF

    position sprite SPR_SLIME, px#, GROUND
    position sprite SPR_HAT, fink sprite point x(SPR_SLIME, POINT_SLIME_TOP), fink sprite point y(SPR_SLIME, POINT_SLIME_TOP) - 8

    IF new key down(keyM)
        mapShown = 1 - mapShown
        IF mapShown = 1
            show sprite SPR_MAP
        ELSE
            hide sprite SPR_MAP
        ENDIF
    ENDIF
    sync
LOOP
