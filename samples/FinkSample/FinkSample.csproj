<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The Fink sample: a small Fade.MonoGame game that plays animations drawn in Fink.

          art/sample.fink           the art, as a Fink project (open it in Fink)
          art/make-art.fink-test    the script that drew it
          Assets/Textures/sprites*  the atlas Fink exported (Ctrl+E in Fink writes these)
          fink_sprites.fbasic       the TAG_ / PAL_ constants Fink generated, and the load function
          game.fbasic               the game

        Fade.MonoGame and Fade.MonoGame.Fink come BY SOURCE from ../../../fade.mono.
        Run it with: dotnet run   (Debug: edit game.fbasic while it runs; re-export from Fink
        and the art updates live)
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>Major</RollForward>
        <AssemblyName>FinkSample</AssemblyName>
        <RootNamespace>FinkSample</RootNamespace>
        <TieredCompilation>false</TieredCompilation>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <FadeGenerateMain>false</FadeGenerateMain>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputType>WinExe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(FadeMonoDir)\Fade.MonoGame.Lib\Fade.MonoGame.Lib.csproj" />
        <ProjectReference Include="$(FadeMonoDir)\Fade.MonoGame.Game\Fade.MonoGame.Game.csproj" />
        <ProjectReference Include="$(FadeMonoDir)\Fade.MonoGame.Contracts\Fade.MonoGame.Contracts.csproj" />
        <ProjectReference Include="$(FadeMonoDir)\Fade.MonoGame.Fink\Fade.MonoGame.Fink.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FadeBasic.Lib.Standard" Version="$(FadeVersion)" />
        <PackageReference Include="FadeBasic.Lang.CommandSourceGenerator" Version="$(FadeVersion)" />
        <PackageReference Include="FadeBasic.Build" Version="$(FadeVersion)" />
    </ItemGroup>

    <!-- Debug: content is built in-process at startup and hot-reloads, and the program is
         compiled from source at runtime so F1/F2 swap it in. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <ProjectReference Include="$(FadeMonoDir)\Fade.MonoGame.Content\Fade.MonoGame.Content.csproj" />
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ProjectDir</_Parameter1>
            <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>$(DefineConstants);FADE_CONTENT_HOTRELOAD</DefineConstants>
    </PropertyGroup>

    <!-- The command surface the program can use. Program.cs reads it back from GeneratedFade. -->
    <ItemGroup>
        <FadeCommand Include="FadeBasic.Lib.Standard" FullName="FadeBasic.Lib.Standard.StandardCommands" />
        <FadeCommand Include="Fade.MonoGame.Lib" FullName="Fade.MonoGame.Lib.FadeMonoGameCommands" />
        <FadeCommand Include="Fade.MonoGame.Fink" FullName="Fade.MonoGame.Fink.FadeFinkCommands" />
    </ItemGroup>

    <!-- ORDER IS THE PROGRAM: Fink's constants first (they are text replacement), then the game. -->
    <ItemGroup>
        <FadeSource Include="fink_sprites.fbasic" />
        <FadeSource Include="game.fbasic" />
    </ItemGroup>

    <!-- The content build skips .json, so the atlas manifests are copied next to the built
         content, where Fade.MonoGame.Fink looks for them (a Debug build reads Assets/ directly). -->
    <ItemGroup>
        <None Include="Assets\**\*.atlas.json" Link="Content\%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ImGui.NET" Version="$(ImGuiVersion)" />
    </ItemGroup>
    <ItemGroup Condition="'$(FadeMonoGamePlatform)' == 'Desktop'">
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonogameVersion)" />
    </ItemGroup>
    <ItemGroup Condition="'$(FadeMonoGamePlatform)' == 'DesktopVK'">
        <PackageReference Include="MonoGame.Framework.Native" Version="$(MonogameVersion)" />
        <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="$(MonogameVersion)" />
        <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Version="$(MonogameVersion)" />
        <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" Version="$(MonogameVersion)" />
    </ItemGroup>

    <!-- Release builds its content with fade.mono's content CLI (Debug builds it in-process). -->
    <PropertyGroup>
        <_GameAssetsDir>$(MSBuildProjectDirectory)/Assets</_GameAssetsDir>
        <_GameContentObjDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)gamecontent</_GameContentObjDir>
        <_FadeContentProject>$(FadeMonoDir)/Fade.MonoGame.Content/Fade.MonoGame.Content.csproj</_FadeContentProject>
    </PropertyGroup>
    <Target Name="BuildGameContent" Condition="'$(Configuration)' != 'Debug' AND Exists('$(_GameAssetsDir)')" BeforeTargets="AssignTargetPaths">
        <MakeDir Directories="$(_GameContentObjDir)" />
        <Exec Command="dotnet restore &quot;$(_FadeContentProject)&quot;" StandardOutputImportance="low" />
        <MSBuild Projects="$(_FadeContentProject)" Targets="Build"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;RuntimeIdentifiers;FadeMonoGamePlatform;SelfContained;PublishTrimmed;PublishReadyToRun">
            <Output TaskParameter="TargetOutputs" ItemName="_GameContentCli" />
        </MSBuild>
        <Exec Command="dotnet &quot;@(_GameContentCli)&quot; --platform $(FadeMonoGamePlatform) --source &quot;$(_GameAssetsDir)&quot; --output &quot;$(_GameContentObjDir)&quot; --intermediate &quot;$(_GameContentObjDir)/obj&quot;"
              CustomErrorRegularExpression="\[E\] .+" />
        <ItemGroup>
            <Content Include="$(_GameContentObjDir)/Content/**/*">
                <Link>Content/%(RecursiveDir)%(Filename)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            </Content>
        </ItemGroup>
    </Target>

    <PropertyGroup>
        <FadeGameTitle>Fink Sample</FadeGameTitle>
        <FadeWindowMode>Windowed</FadeWindowMode>
        <FadeWindowResizable>true</FadeWindowResizable>
    </PropertyGroup>
    <Import Project="$(FadeMonoDir)\Fade.MonoGame.Game\buildTransitive\FadeBasic.MonoGame.App.targets" />
</Project>
